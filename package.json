{
  "name": "borderfall",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.js",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "format": "prettier --write src tests *.ts *.json index.html",
    "format:check": "prettier --check src tests *.ts *.json index.html"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "prettier": "^3.0.0",
    "sass-embedded": "^1.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vite": "^7.0.0",
    "vite-plugin-pwa": "^1.0.0"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.0.0",
    "@fontsource/space-grotesk": "^5.0.0",
    "workbox-window": "^7.4.1"
  },
  "packageManager": "pnpm@11.25.0"
}
